{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolManifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "id": {
      "$ref": "#/$defs/ToolId"
    },
    "name": {
      "type": "string"
    },
    "category": {
      "$ref": "#/$defs/Category"
    },
    "tool_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "description": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/InputPort"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/OutputPort"
      }
    },
    "engine": {
      "type": "string"
    },
    "capabilities": {
      "$ref": "#/$defs/Capabilities"
    },
    "permissions": {
      "$ref": "#/$defs/Permissions"
    },
    "platforms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Platform"
      }
    },
    "parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Parameter"
      }
    },
    "presets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Preset"
      }
    },
    "ui": {
      "anyOf": [
        {
          "$ref": "#/$defs/UiHints"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "name",
    "category",
    "tool_version",
    "description",
    "keywords",
    "inputs",
    "outputs",
    "engine",
    "capabilities",
    "permissions",
    "platforms",
    "presets"
  ],
  "$defs": {
    "ToolId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){1,2}$"
    },
    "Category": {
      "type": "string",
      "enum": [
        "pdf",
        "image",
        "video",
        "audio",
        "files",
        "text",
        "qr",
        "developer",
        "privacy",
        "network",
        "system",
        "screen",
        "ocr"
      ]
    },
    "InputPort": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/DataType"
        },
        "multiple": {
          "type": "boolean",
          "default": false
        },
        "optional": {
          "description": "Text input may be left empty.",
          "type": "boolean",
          "default": false
        },
        "min_files": {
          "description": "The tool needs this many files, so it is not suggested for fewer.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "folders": {
          "description": "The tool looks through folders, so it is not suggested for lone files.",
          "type": "boolean",
          "default": false
        },
        "mime": {
          "description": "Required for file inputs.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extensions": {
          "description": "Lowercase, without the leading dot, or `*` for anything. Required for file inputs.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "DataType": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "image",
            "pdf",
            "video",
            "audio",
            "archive",
            "text",
            "json"
          ]
        },
        {
          "description": "Any file or folder. `extensions` is `[\"*\"]`.",
          "type": "string",
          "const": "any"
        },
        {
          "description": "The tool takes no input.",
          "type": "string",
          "const": "none"
        }
      ]
    },
    "OutputPort": {
      "type": "object",
      "properties": {
        "type": {
          "$ref": "#/$defs/DataType"
        },
        "multiple": {
          "type": "boolean",
          "default": false
        },
        "filename": {
          "description": "Output file name template, e.g. `{stem}-small.{ext}`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "type"
      ]
    },
    "Capabilities": {
      "type": "object",
      "properties": {
        "batch": {
          "type": "boolean"
        },
        "preview": {
          "type": "boolean"
        },
        "offline": {
          "type": "boolean"
        },
        "destructive": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "batch",
        "preview",
        "offline",
        "destructive"
      ]
    },
    "Permissions": {
      "type": "object",
      "properties": {
        "network": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "Platform": {
      "type": "string",
      "enum": [
        "windows",
        "macos",
        "linux"
      ]
    },
    "Parameter": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "$ref": "#/$defs/ParamType"
        },
        "optional": {
          "type": "boolean",
          "default": false
        },
        "secret": {
          "description": "The value is a password: the UI hides it. Only for `string`.",
          "type": "boolean",
          "default": false
        },
        "multiline": {
          "description": "The value spans lines: the UI gives it a text area. Only for `string`.",
          "type": "boolean",
          "default": false
        },
        "min": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "max": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "values": {
          "description": "Allowed values; required for `enum`, forbidden otherwise.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default": true
      },
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ]
    },
    "ParamType": {
      "type": "string",
      "enum": [
        "integer",
        "number",
        "boolean",
        "string",
        "enum"
      ]
    },
    "Preset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ]
    },
    "UiHints": {
      "type": "object",
      "properties": {
        "advanced": {
          "description": "Parameters hidden under the \"Advanced\" disclosure.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "one_of": {
          "description": "Optional parameters of which the tool needs at least one.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preview": {
          "description": "Custom preview widget, e.g. `image-compare`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
